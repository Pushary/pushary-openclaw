{
  "name": "@pushary/openclaw",
  "version": "0.1.8",
  "description": "Phone approvals for OpenClaw. Pushary asks you before your AI agent runs a gated tool call, and blocks the call unless you approve it.",
  "author": "Pushary <business@pushary.com>",
  "homepage": "https://pushary.com/human-in-the-loop-openclaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pushary/pushary-openclaw.git"
  },
  "bugs": {
    "url": "https://pushary.com/support"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/ci/run-tests.mjs src",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3"
    },
    "install": {
      "npmSpec": "@pushary/openclaw",
      "minHostVersion": ">=2026.11.3"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pushary",
    "openclaw",
    "openclaw-plugin",
    "human-in-the-loop",
    "approval",
    "tool-approval",
    "push-notifications",
    "ai-agents"
  ]
}
